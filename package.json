{
  "name": "sqlfox",
  "version": "0.18.0",
  "private": true,
  "description": "High-Performance, Single-Binary Database Manager & Headless Automation CLI",
  "scripts": {
    "test": "node scripts/test-grid-ergonomics-suite.mjs && node scripts/test-svelte-codemirror.mjs",
    "test:editor": "node scripts/test-svelte-codemirror.mjs",
    "test:editor:browser": "node scripts/test-svelte-codemirror-browser.mjs",
    "build": "node scripts/build_web.js",
    "build:web": "node scripts/build_web.js",
    "build:svelte": "npm --prefix web/frontend run build && cp -r web/dist_svelte/* web/dist/",
    "dev:svelte": "npm --prefix web/frontend run dev",
    "build:cm": "node scripts/build_codemirror.js",
    "build:css": "tailwindcss -c scripts/tailwind.config.js -i scripts/tailwind-input.css -o web/dist/vendor/tailwind/tailwind.css -m",
    "watch:css": "tailwindcss -c scripts/tailwind.config.js -i scripts/tailwind-input.css -o web/dist/vendor/tailwind/tailwind.css -w"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17"
  }
}
